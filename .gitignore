# ==================================================
# 一、通用嵌入式编译产物（所有工具链通用）
# ==================================================
# 编译中间文件
*.o
*.obj
*.d
*.crf
*.su
*.i
*.ii
*.s
*.S

# 固件与可执行文件
*.elf
*.axf
*.bin
*.hex
*.s19
*.srec
*.map
*.lst

# 静态库与链接文件
*.a
*.lib
*.ar

# ==================================================
# 二、Keil MDK（ARM-MCU主流开发环境）
# ==================================================
# 个人界面配置文件（每人本地不同，无需提交）
*.uvguix.*
*.uvgui.*

# 默认编译输出目录（自定义目录名需自行补充）
Objects/
Listings/
RTE/

# 临时与备份文件
*.dep
*.bak
*.scvd
*.dbgconf
*.dni
*.iex

# ==================================================
# 三、IAR Embedded Workbench
# ==================================================
# 用户个人设置目录
settings/

# 默认编译输出目录
Debug/
Release/
Build/

# 临时与备份文件
*.dep
*.bak
*.ewt
*.driverInfo
*.sim
*.cspy.bat

# ==================================================
# 四、STM32CubeIDE / Eclipse 系列
# ==================================================
# 工作区缓存与个人偏好
.metadata/
.settings/
RemoteSystemsTempFiles/

# 编译输出目录
Debug/
Release/

# 脚本缓存
*.pyc
__pycache__/

# 注：.project / .cproject / .ioc 是工程核心文件，建议提交，此处不忽略

# ==================================================
# 五、VS Code + 嵌入式开发插件
# ==================================================
# C/C++ 插件索引缓存
.vscode/ipch/
*.browse.vc.db
*.vc.db

# 个人配置（如需统一团队配置，可注释本行，单独保留公共文件）
.vscode/*
# 团队统一配置示例（按需取消注释）
# !.vscode/tasks.json
# !.vscode/launch.json
# !.vscode/c_cpp_properties.json

# ==================================================
# 六、PlatformIO 开发框架
# ==================================================
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json

# ==================================================
# 七、硬件仿真与调试工具
# ==================================================
# J-Link 配置与会话
*.jlink
*.jlinksession

# ST-Link 配置
*.stlink
*.stcfg

# GDB 个人调试脚本
.gdbinit
.gdb_history

# 仿真跟踪文件
*.trace
*.trc

# ==================================================
# 八、系统临时文件 & 通用忽略
# ==================================================
# Windows 系统文件
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS 系统文件
.DS_Store
.AppleDouble
.LSOverride

# 通用临时/备份文件
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.log

# 压缩包（固件发布包按需保留）
*.zip
*.rar
*.7z
