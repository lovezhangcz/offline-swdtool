".\obj_app_msc\flash_algo.o"
".\obj_app_msc\flash_algo_gd32f1x0.o"
".\obj_app_msc\flash_algo_stm32f1.o"
".\obj_app_msc\swd_host.o"
".\obj_app_msc\usb_hw.o"
