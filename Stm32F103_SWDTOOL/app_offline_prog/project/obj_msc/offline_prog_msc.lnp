--cpu Cortex-M3
".\obj_msc\startup_stm32f10x_md.o"
".\obj_msc\system_stm32f10x.o"
".\obj_msc\main.o"
".\obj_msc\bsp.o"
".\obj_msc\crc.o"
".\obj_msc\storage.o"
".\obj_msc\proto.o"
".\obj_msc\target_prog.o"
".\obj_msc\flash_algo.o"
".\obj_msc\flash_algo_gd32f1x0.o"
".\obj_msc\flash_algo_stm32f1.o"
".\obj_msc\swd_host.o"
".\obj_msc\usb_hw.o"
".\obj_msc\usb_cdc.o"
".\obj_msc\usb_msc.o"
