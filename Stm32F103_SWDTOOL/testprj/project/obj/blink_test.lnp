--cpu Cortex-M3
".\obj\startup_stm32f10x_md.o"
".\obj\system_stm32f10x.o"
".\obj\main.o"
--library_type=microlib --strict --scatter ".\obj\blink_test.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --callgraph --symbols
--info sizes
--list ".\list\blink_test.map" -o .\obj\blink_test.axf